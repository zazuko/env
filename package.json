{
  "name": "zazuko-env",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --quiet",
    "test": "wsrun -sm --report --no-prefix test",
    "release": "changeset publish"
  },
  "author": "Zazuko GmbH",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@tpluscode/eslint-config": "^4.0.4",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "c8": "^8.0.1",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "wsrun": "^5.2.4"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --quiet"
    ]
  },
  "mocha": {
    "extension": "ts",
    "loader": "ts-node/esm"
  }
