#!/bin/sh
set -eu

# skill-check cannot pass scanner authentication options. Keep the installed
# mcp-scan 0.4.2 binary and supply the token-authenticated legacy API endpoint.
: "${SNYK_TOKEN:?Set the SNYK_TOKEN repository secret to authenticate the security scan}"

exec "$(uv tool dir --bin)/mcp-scan" \
  --analysis-url 'https://api.snyk.io/hidden/mcp-scan/cli/analysis-machine?version=2025-09-02' \
  --verification-H "Authorization: token $SNYK_TOKEN" \
  "$@"
